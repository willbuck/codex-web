# Firebase env for Vite (optional for local mock play)

# Copy to `.env.local` for local development. For GitHub Pages, set the
# same names as repository Actions secrets and pass them into the build.
# Without these, the app runs with in-memory mock state only.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
# VITE_FIREBASE_MEASUREMENT_ID=
