# Firebase env for Vite (optional — without these the app stays in local mock mode)

# 1. Create a Firebase project + Web app in the Firebase Console
# 2. Enable Cloud Firestore
# 3. Copy values here into `.env.local` (never commit that file)
# 4. Deploy `firestore.rules` to the project
# 5. For Pages, set the same names as GitHub Actions repository secrets
#
# See docs/FIREBASE_SETUP.md for the full checklist.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
# VITE_FIREBASE_MEASUREMENT_ID=
