rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Session code is the document id and the capability secret.
    // Anyone who knows the code can read/write that session.
    // Suitable for private table play — not for adversarial public rooms.
    match /sessions/{sessionId} {
      allow read: if sessionId.size() >= 4 && sessionId.size() <= 12;

      allow create: if sessionId.size() >= 4
        && sessionId.size() <= 12
        && request.resource.data.keys().hasAll([
          'code', 'players', 'zones', 'createdAt', 'lastUpdated'
        ])
        && request.resource.data.code == sessionId
        && request.resource.data.zones.keys().hasAll(['hand', 'inPlay', 'discard']);

      allow update: if sessionId.size() >= 4
        && sessionId.size() <= 12
        && request.resource.data.code == resource.data.code
        && request.resource.data.zones.keys().hasAll(['hand', 'inPlay', 'discard']);

      allow delete: if false;
    }
  }
}
